<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Always Light -->
    <style name="Base.Theme.Restaurantapp" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary color - Blue -->
        <item name="colorPrimary">#2563EB</item>
        <item name="colorPrimaryVariant">#1D4ED8</item>
        
        <!-- Secondary color - Green -->
        <item name="colorSecondary">#16A34A</item>
        <item name="colorSecondaryVariant">#15803D</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">#F8FAFC</item>
        <item name="colorSurface">#FFFFFF</item>
        
        <!-- Text colors - Ensure dark text on light background -->
        <item name="android:textColorPrimary">#1E293B</item>
        <item name="android:textColorSecondary">#64748B</item>
        <item name="android:textColorHint">#94A3B8</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Navigation bar color -->
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Restaurantapp" parent="Base.Theme.Restaurantapp" />
</resources>
