<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAdminItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blue Rice"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAdminItemPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Rs Rs 300"
                android:textColor="#16A34A"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvAdminItemCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Veg Rice"
                android:textColor="#64748B"
                android:textSize="12sp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnDeleteAdminItem"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#EF4444"
            android:text="Delete"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            app:cornerRadius="6dp"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
