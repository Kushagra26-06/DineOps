<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Restaurantapp"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Login Activity -->
        <activity
            android:name=".LoginActivity"
            android:exported="true" />
        <!-- SignUp Activity -->
        <activity
            android:name=".SignUpActivity"
            android:exported="true" />
        <!-- Customer Activities -->
        <activity
            android:name=".HomeActivity"
            android:exported="true" />
        <activity
            android:name=".MenuActivity"
            android:exported="true" />
        <activity
            android:name=".VegsoupActivity"
            android:exported="true" />
        <activity
            android:name=".VegsnacksActivity"
            android:exported="true" />
        <activity
            android:name=".VeggravyActivity"
            android:exported="true" />
        <activity
            android:name=".VegnoodlesActivity"
            android:exported="true" />
        <activity
            android:name=".VegriceActivity"
            android:exported="true" />
        <activity
            android:name=".OrderActivity"
            android:exported="true" />
        <!-- Owner & Manager Activities -->
        <activity
            android:name=".OwnerDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ManagerDashboardActivity"
            android:exported="false" />
        <!-- Staff Activity -->
        <activity
            android:name=".StaffActivity"
            android:exported="false" />
    </application>

</manifest>